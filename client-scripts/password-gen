#!/usr/bin/env python3
"""Print one cryptographically random password in the form 5-6-7."""

import os
import sys

# Latin letters, digits, and the punctuation requested by the user.
ALPHABET = (
    "abcdefghijklmnopqrstuvwxyz"
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    "0123456789"
    "!+-_)(*&^%$#@!/*+\\`\":?><"
)


def secure_choice() -> str:
    """Use rejection sampling so every character has equal probability."""
    bound = 256 - (256 % len(ALPHABET))
    while True:
        value = os.urandom(1)[0]
        if value < bound:
            return ALPHABET[value % len(ALPHABET)]


def main() -> None:
    if len(set(ALPHABET)) != len(ALPHABET):
        # Repeated characters would not reduce security, but make the intended
        # alphabet less clear. Keep the source definition explicit instead.
        alphabet = "".join(dict.fromkeys(ALPHABET))
    else:
        alphabet = ALPHABET

    # The local function keeps the sampling bound aligned with the final alphabet.
    def choose() -> str:
        bound = 256 - (256 % len(alphabet))
        while True:
            value = os.urandom(1)[0]
            if value < bound:
                return alphabet[value % len(alphabet)]

    print("-".join("".join(choose() for _ in range(length)) for length in (5, 6, 7)))


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
