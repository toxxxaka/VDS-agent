[Unit]
Description=Monitoringbot constrained infrastructure bridge
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/monitorbot-infrad
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
MemoryMax=256M
CPUQuota=25%
UMask=0077
ReadWritePaths=/var/lib/monitoringbot /run/monitorbot

[Install]
WantedBy=multi-user.target
