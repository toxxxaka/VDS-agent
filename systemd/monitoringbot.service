[Unit]
Description=Telegram monitoring bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=monitorbot
Group=monitorbot
EnvironmentFile=/etc/monitoringbot-main/telegram.env
EnvironmentFile=-/etc/monitoringbot-main/timeweb-ai.env
Environment=MONITORINGBOT_STATE_DIR=/var/lib/monitoringbot
Environment=MONITORINGBOT_SSH_ALLOWLIST=/etc/monitoringbot/ssh-allowlist.json
Environment=MONITORINGBOT_AUTH_CONFIG=/etc/monitoringbot-main/auth.json
Environment=MONITORINGBOT_SERVERS_CONFIG=/etc/monitoringbot-main/servers.json
WorkingDirectory=/opt/monitoringbot
ExecStart=/usr/bin/python3 /opt/monitoringbot/v3.py
Restart=always
UMask=0077
RestartSec=10
StateDirectory=monitoringbot
StateDirectoryMode=0750
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/monitoringbot

[Install]
WantedBy=multi-user.target
