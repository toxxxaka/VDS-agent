[Unit]
Description=Telegram alert for successful SSH logins outside allowlist
After=systemd-journald.service
ConditionPathExists=/var/log/auth.log

[Service]
Type=oneshot
User=monitorbot
Group=monitorbot
SupplementaryGroups=adm
EnvironmentFile=/etc/monitoringbot-main/telegram.env
Environment=MONITORINGBOT_STATE_DIR=/var/lib/monitoringbot
Environment=MONITORINGBOT_SSH_ALLOWLIST=/etc/monitoringbot/ssh-allowlist.json
WorkingDirectory=/opt/monitoringbot
ExecStart=/usr/bin/python3 /opt/monitoringbot/v3.py --check-ssh-logins
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
StateDirectory=monitoringbot
ReadWritePaths=/var/lib/monitoringbot
