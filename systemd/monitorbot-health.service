[Unit]
Description=Monitoringbot CPU and network alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitorbot
Group=monitorbot
EnvironmentFile=/etc/monitoringbot-main/telegram.env
Environment=MONITORINGBOT_HEALTH_CONFIG=/etc/monitoringbot-main/health.json
Environment=MONITORINGBOT_HEALTH_STATE=/var/lib/monitoringbot/health_state.json
ExecStart=/usr/bin/python3 /opt/monitoringbot/health_monitor.py
Restart=always
RestartSec=5
StateDirectory=monitoringbot
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=256M
CPUQuota=35%
ReadWritePaths=/var/lib/monitoringbot

[Install]
WantedBy=multi-user.target
