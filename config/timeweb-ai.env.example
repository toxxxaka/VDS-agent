# Copy outside the repository: /etc/monitoringbot-main/timeweb-ai.env
# Keep mode 0600 and ownership root:root.
# OpenAI URL is the full private AI Agent chat-completions URL from Timeweb.
TIMEWEB_AI_OPENAI_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/example-agent-id/v1/chat/completions
TIMEWEB_AI_API_TOKEN=replace-with-private-token
# Optional. Timeweb Agent API ignores model, but some compatible endpoints require it.
TIMEWEB_AI_MODEL=agent
