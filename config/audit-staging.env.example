# Separate audit instance only. Never add these settings to normal services.
MONITORINGBOT_AUDIT_DUMMY=1
MONITORINGBOT_DB=/var/lib/monitoringbot-audit/monitoring.db
MONITORINGBOT_STATE_DIR=/var/lib/monitoringbot-audit
MONITORINGBOT_RUNBOOK_DIR=/etc/monitoringbot-audit/runbooks
MONITORINGBOT_WEB_PORT=8788
